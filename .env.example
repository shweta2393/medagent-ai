# ============================================
# MedAgent AI - LLM Configuration
# ============================================
# Set at least ONE API key below. Groq is recommended (fast + generous free tier).
# The system auto-falls back to the other provider if the primary one fails.

# LLM Provider: "groq" (recommended) or "gemini"
LLM_PROVIDER=groq

# Groq API Key (recommended - free, fast, generous limits)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (fallback)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Embedding model for RAG (no API key needed - runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2
